{
  "manifest_version": 3,
  "name": "Facelift for Outlook",
  "version": "1.0.0",
  "description": "A clean, dark, keyboard-first redesign for Outlook on the web. Hides clutter and adds J/K navigation and a Ctrl+K palette.",
  "author": "Shabari K S",
  "homepage_url": "https://github.com/Shabari-K-S/facelift-for-outlook",
  "browser_specific_settings": {
    "gecko": {
      "id": "facelift-for-outlook@shabari-k-s",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Facelift for Outlook",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://outlook.live.com/*"
      ],
      "css": [
        "styles/redesign.css"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
